# This kit's own origin. Canonicals, OpenGraph tags, the sitemap and the
# JSON-LD all generate against it.
NEXT_PUBLIC_SITE_URL=https://newsletter.useeverykit.com

# The EveryKit hub. The header, the footer and the "More from EveryKit" strip
# read this. The strip fetches ${NEXT_PUBLIC_HUB_URL}/kits.json and disappears
# without complaint if the hub is unreachable.
NEXT_PUBLIC_HUB_URL=https://useeverykit.com

# "false" or unset is launch mode: the export is free. "true" is the seam for a
# future paid step (hosted images), which is not built yet.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# The product's Lemon Squeezy checkout URL. Only read when payments are on, and
# the buy button reports a clear error rather than failing quietly if it is
# missing.
# Example: https://everykit.lemonsqueezy.com/buy/00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=
