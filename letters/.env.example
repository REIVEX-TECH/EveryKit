# This kit's own origin. Canonicals, OpenGraph, the sitemap and JSON-LD all
# generate against it.
NEXT_PUBLIC_SITE_URL=https://letters.useeverykit.com

# The hub. The header, the footer, the "More from EveryKit" strip and the email
# ask all read this. Must be on the kit's CSP connect-src.
NEXT_PUBLIC_HUB_URL=https://useeverykit.com

# "false" or unset is launch mode: the PDF and DOCX are free and the download
# shows a quiet "launch week — free" badge. "true" puts them behind Lemon
# Squeezy checkout and leaves the on-screen letter and Copy text free.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# The product's Lemon Squeezy checkout URL. Only read when payments are on.
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=

# Phase 2 only. Leave false: the polish step is a stub and there is no API key
# handling anywhere in this app.
NEXT_PUBLIC_AI_POLISH_ENABLED=false
