# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Local environment. The .example files are tracked on purpose — they are the
# documentation of what each app needs. Everything else here holds real
# secrets, including .env.production on the VPS.
.env
.env.*
!.env.example
!.env.production.example

# Vercel
.vercel

# What deploy.sh remembers about the box it is running on: the commit it last
# deployed and the package-lock hash it last installed for each app. Per-box
# state, never the same on two machines, and meaningless in the repo.
.deployed-sha
.deployed-locks

# Test and tooling output
coverage/
.eslintcache

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor and OS junk
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~

# Certificates and keys, in case one ever lands here by accident
*.pem
*.key
*.p12

# Agent/editor workspace config, kept local
.claude/

# The crop regression photo is a real person's face. It stays on the machine
# that reproduces the bug and is never committed: this repo is public, and a
# face pushed here would be permanent. The test that uses it skips when it is
# absent, so CI stays green without it.
photos/test/fixtures/regression-1.jpg
