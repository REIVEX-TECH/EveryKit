# The hub's own origin. Canonicals, the sitemap and OpenGraph generate
# against it.
NEXT_PUBLIC_SITE_URL=https://useeverykit.com

# Postgres, holding the one table EveryKit has: email addresses.
#
# Production: the POOLED connection string from Neon, not the direct one —
# serverless functions open and drop connections constantly and the pooler is
# what stops that exhausting the database.
#
# Local: docker compose up -d, then
#   DATABASE_URL=postgres://everykit:everykit@localhost:5432/everykit
#
# Without it, /api/subscribe answers 500 and every kit falls back to handing
# over the file anyway, which is the intended failure mode.
DATABASE_URL=
