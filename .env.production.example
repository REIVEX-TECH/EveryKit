# Copy to .env.production on the VPS and fill in. That file is git-ignored and
# must stay that way — it is the only place a real secret lives.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# ecosystem.config.js reads it at PM2 start and merges it into each app's
# environment. Changing a value here needs `pm2 reload ecosystem.config.js
# --update-env` to take effect; a plain restart keeps the old environment.

# Postgres, running on this same machine and listening on localhost only.
# The password is the one set for the `everykit` role.
# Without this the hub's /api/subscribe answers 500 and every kit falls back to
# handing over the file anyway, which is the intended failure mode.
DATABASE_URL=postgres://everykit:PASSWORD_HERE@localhost:5432/everykit

# The /admin dashboard on the hub. Without all three, nobody can log in: it
# fails shut rather than falling back to anything.
#
# ADMIN_PASSWORD_HASH is a bcrypt hash, never the password. Produce it with:
#
#   npm run hash-password --prefix hub -- "the password you chose"
#
# and paste the line it prints. The plaintext is never stored or logged.
#
# SESSION_SECRET signs the session cookie. Any long random string; changing it
# logs the session out, which is also how you revoke one. Generate with:
#
#   openssl rand -base64 48
ADMIN_EMAIL=ahad@reivex.io
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Lemon Squeezy, when payments are switched on. Left empty deliberately: the
# buy button reports a clear error rather than failing quietly if it is missing,
# and NEXT_PUBLIC_PAYMENTS_ENABLED is false in ecosystem.config.js for launch.
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=
